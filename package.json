{
  "name": "setup-godot",
  "version": "1.0.0",
  "private": true,
  "description": "Setup Godot for use with .NET on macOS, Windows, and Linux CI/CD runners.",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint",
    "package": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --outfile=dist/index.js",
    "test": "vitest run",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chickensoft-games/setup-godot.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.0.0",
    "@actions/core": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "eslint-plugin-jest": "^29.16.5",
    "normalize-path": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.10.13",
    "@types/normalize-path": "^3.0.2",
    "@typescript-eslint/parser": "^8.56.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-github": "^6.1.2",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "js-yaml": "^4.1.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
